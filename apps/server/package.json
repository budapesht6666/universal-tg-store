{
  "name": "@store/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "API магазина, бот, база данных и раздача Mini App и админки",
  "exports": {
    "./api": "./src/app.ts"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=../../.env src/main.ts",
    "start": "node --env-file-if-exists=../../.env src/main.ts",
    "typecheck": "tsc -p . --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@hono/node-server": "catalog:",
    "@store/schema": "workspace:*",
    "@tma.js/init-data-node": "catalog:",
    "better-sqlite3": "catalog:",
    "drizzle-orm": "catalog:",
    "grammy": "catalog:",
    "hono": "catalog:",
    "sharp": "catalog:"
  },
  "devDependencies": {
    "@types/better-sqlite3": "catalog:",
    "@types/node": "catalog:",
    "drizzle-kit": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
