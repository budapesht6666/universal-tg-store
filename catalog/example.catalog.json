  "settings": {
    "shop": {
      "name": "Universal Store",
      "description": "Одежда, аксессуары и мелочи для дома",
      "greeting": "Привет! Здесь одежда и аксессуары на каждый день. Открывайте магазин — доставим за 1–2 дня.",
      "locale": "ru-RU",
      "currency": "RUB"
    },
    "features": {
      "categories": true,
      "search": true,
      "sort": true,
      "gallery": true,
      "discounts": true,
      "badges": true,
      "stock": true
    },
    "catalog": {
      "defaultView": "grid"
    },
    "checkout": {
      "phoneFromTelegramOnly": false,
      "maxQtyPerItem": 100
    },
    "orders": {
      "customerCanCancel": true
    },
    "delivery": {
      "assignment": "manual",
      "shopPhone": "+7 495 000-00-00"
    }
  },
  "attributes": [
    {
      "key": "material",
      "label": "Материал",
      "type": "select",
      "options": [
        "Хлопок",
        "Смесовая ткань",
        "Шерсть",
        "Канвас",
        "Полиэстер",
        "Кожа",
        "Керамика",
        "Тритан"
      ],
      "showInSpecs": true
    },
    {
      "key": "density",
      "label": "Плотность",
      "type": "number",
      "integer": true,
      "min": 40,
      "max": 600,
      "unit": "г/м²",
      "hint": "От 40 до 600"
    },
    {
      "key": "fit",
      "label": "Посадка",
      "type": "select",
      "options": ["Прямая", "Оверсайз", "Приталенная"]
    },
    {
      "key": "organic",
      "label": "Органический хлопок",
      "type": "boolean",
      "showInCard": true
    },
    {
      "key": "volume",
      "label": "Объём",
      "type": "number",
      "integer": true,
      "min": 1,
      "unit": "мл"
    },
    {
      "key": "care",
      "label": "Уход",
      "type": "textarea",
      "maxLength": 300
    }
  ],
