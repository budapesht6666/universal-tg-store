# Telegram
# Токен бота от @BotFather
BOT_TOKEN=
# Ваш числовой Telegram ID (узнать у @userinfobot). При первом запуске станет владельцем
OWNER_TELEGRAM_ID=

# Сервер
# Публичный https-адрес: по нему открывается Mini App и приходит вебхук. Локально — адрес туннеля
PUBLIC_URL=
PORT=3000

# Данные
DATABASE_PATH=./data/store.db
UPLOADS_DIR=./data/uploads

# Секреты: случайные строки от 32 символов
# Подпись входа в админку
SESSION_SECRET=
# Проверка, что вебхук прислал Telegram
WEBHOOK_SECRET=

# Необязательно
# Бот: polling — локально, webhook — на сервере (по умолчанию выбирается по NODE_ENV), off — без бота
# BOT_MODE=
# NODE_ENV=production
